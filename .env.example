# URL do projeto Supabase — pública, a RLS é que protege os dados
NEXT_PUBLIC_SUPABASE_URL=

# Chave publicável (antiga "anon key") — pública, idem
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Chave de serviço — IGNORA a RLS.
# Só em lib/supabase/admin.ts, que é server-only. Nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# URL canônica do site, para montar os links de callback do e-mail de convite
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Assistente de IA (fase 7) ----------------------------------------------

# Chave da API do Gemini — SEGREDO, só no servidor.
# Nunca prefixe com NEXT_PUBLIC_: isso a colocaria no bundle do navegador.
GEMINI_API_KEY=

# Opcional. Sobrescreve a cadeia de modelos, em ordem de preferência, separada
# por vírgula. Vazia ou inválida, vale o padrão de lib/ai/models.ts — que começa
# pelo mais recente. Serve para corrigir um id de modelo sem fazer deploy.
# Ex.: gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash
GEMINI_MODELS=

# Segredo que autoriza /api/ai/sweep, a varredura que termina os trabalhos da IA
# quando o app está fechado. Na Vercel, o cron manda `Authorization: Bearer <isto>`.
# Gere com: openssl rand -base64 32
CRON_SECRET=

# --- Avisos por push (fase 7) -----------------------------------------------
# Gere o par com:  npx web-push generate-vapid-keys
# Sem as três, a notificação simplesmente não é oferecida na tela de ajustes.

# Pública — o navegador precisa dela para criar a inscrição.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# Privada — SEGREDO, assina o envio.
VAPID_PRIVATE_KEY=

# Contato exigido pelo protocolo, para o serviço de push saber com quem falar.
VAPID_SUBJECT=mailto:voce@exemplo.com
